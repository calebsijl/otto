# copy this file to .env and fill in what you are using.
# .env is gitignored. never commit it.

# --- phase 1, free testing -------------------------------------------------
# GEMINI_API_KEY=AIza...
# OTTO_MODEL=gemini-2.5-flash

# --- or openrouter: one key, free models to test with, claude when you want it
# OPENROUTER_API_KEY=sk-or-...
# OTTO_MODEL=anthropic/claude-sonnet-5-5
# OTTO_MODEL=meta-llama/llama-3.3-70b-instruct:free     # free, for smoke testing

# --- phase 3, the real run -------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
#
# two models. most ticks are small and go on the cheap one; the ones that
# matter go on the good one. leave these out and these are the defaults.
# OTTO_MODEL_EVERYDAY=claude-haiku-5-5
# OTTO_MODEL_DEEP=claude-sonnet-5-5
# OTTO_DEEP_EVERY=4          at worst, one good tick in every four
#
# how often he wakes. most ticks are small and cost almost nothing, so this
# can be fast. 15min is the default.
# OTTO_EVERY=15min
#
# or force one model for everything:
# OTTO_MODEL=claude-sonnet-5-5

# optional: better web search than the free fallback
# TAVILY_API_KEY=tvly-...
